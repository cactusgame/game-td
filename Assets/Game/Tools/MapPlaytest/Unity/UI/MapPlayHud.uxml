<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="MapPlayHud.uss" />
  <ui:VisualElement name="mapHud" class="map-hud" picking-mode="Ignore">
    <ui:VisualElement name="mapControls" class="controls">
      <ui:Label text="MAP PLAYTEST · P 显示 / 隐藏" class="title" />
      <ui:Label text="WASD / 方向键移动；B 建设模式：点击地块 → 选择建筑 → 原位确认；不可建项置灰，建成后自动返回战斗。" />
      <ui:VisualElement class="buttons">
        <ui:Button name="inspect" text="Inspect" />
        <ui:Button name="build" text="Build tower" />
        <ui:Button name="melee-barracks" text="近战兵营" />
        <ui:Button name="ranged-barracks" text="远程兵营" />
        <ui:Button name="upgrade-barracks" text="升级兵营" />
        <ui:Button name="remove" text="Remove building / wall" />
        <ui:Button name="gate" text="Open / close gate" />
        <ui:Button name="deployment-mode" text="部署瞬移：关" />
        <ui:Button name="restart" text="Restart from map" />
        <ui:Button name="exit" text="Exit playtest" />
      </ui:VisualElement>
      <ui:Label name="status" text="Loading map..." />
      <ui:Label name="barracks-status" text="" />
      <ui:Label text="空格：短按技能1 / 长按技能2；R：附近选中跟随 / 再点原地待命，长按边走边选或驻扎；1/2/3：全部/近战/远程，短按一人、长按全体加入跟随。" />
      <ui:Label name="player-status" text="" />
    </ui:VisualElement>
    <ui:Label name="hero-respawn" text="" class="hero-respawn" picking-mode="Ignore" />
    <ui:Label name="fps" text="FPS --" class="fps" picking-mode="Ignore" />
  </ui:VisualElement>
</ui:UXML>
