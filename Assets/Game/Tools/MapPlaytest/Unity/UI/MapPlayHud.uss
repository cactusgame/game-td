.map-play-document { flex-grow: 1; }
.ai-debug-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: none; }
.ai-debug-overlay.ai-debug-visible { display: flex; }
.ai-debug-label {
    position: absolute; top: 0; left: 0; max-width: 108px;
    padding: 1px 4px; border-radius: 3px;
    background-color: rgba(8, 18, 27, 0.86); color: rgb(160, 238, 255);
    font-size: 11px; white-space: normal;
}
.ai-debug-label.ai-debug-enemy { color: rgb(255, 207, 163); }
.ai-debug-hidden { display: none; }
.ai-debug-details {
    position: absolute; left: 12px; bottom: 152px; max-width: 540px;
    padding: 8px 12px; border-radius: 4px;
    border-left-width: 3px; border-left-color: rgb(80, 215, 240);
    background-color: rgba(8, 18, 27, 0.94); color: rgb(210, 244, 250);
    font-size: 13px; white-space: normal;
}
.ai-debug-legend {
    position: absolute; left: 12px; bottom: 105px;
    padding: 6px 10px; border-radius: 4px;
    background-color: rgba(8, 18, 27, 0.88); color: rgb(160, 238, 255);
    font-size: 13px;
}
.map-hud {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}
.wave-previews { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.wave-preview {
    position: absolute;
    min-width: 130px;
    padding: 6px 12px;
    background-color: rgb(47, 35, 27);
    border-width: 2px;
    border-color: rgb(151, 116, 63);
    border-radius: 22px;
    color: rgb(255, 235, 192);
    -unity-text-align: middle-center;
    font-size: 16px;
}
.wave-preview.wave-ready { border-color: rgb(255, 200, 80); }
.wave-preview:hover { background-color: rgb(82, 57, 31); }
.wave-enemy { flex-direction: row; align-items: center; justify-content: center; }
.wave-enemy-icon { width: 48px; height: 48px; margin-right: 8px; }
.wave-hint {
    position: absolute;
    bottom: 24px;
    align-self: center;
    padding: 10px 18px;
    background-color: rgba(25, 31, 29, 0.9);
    border-radius: 8px;
    color: rgb(255, 227, 155);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.wave-confirm-progress { position: absolute; bottom: 80px; width: 240px; align-self: center; }
.wave-hidden { display: none; }
.controls {
    display: none;
    position: absolute;
    top: 8px;
    right: 120px;
    left: 8px;
    background-color: rgba(17, 27, 36, 0.72);
    color: rgb(236, 241, 238);
    padding: 10px 16px;
    -unity-font: url("project://database/Assets/Content/Shared/Fonts/Inter-Regular.otf");
    font-size: 14px;
}
.controls.debug-visible { display: flex; }
.controls Label { white-space: normal; }
.fps {
    position: absolute;
    top: 8px;
    right: 12px;
    min-width: 80px;
    padding: 5px 10px;
    background-color: rgba(17, 27, 36, 0.65);
    color: rgb(236, 241, 238);
    font-size: 16px;
    -unity-font: url("project://database/Assets/Content/Shared/Fonts/Inter-Regular.otf");
    -unity-text-align: middle-right;
}
.title { font-size: 19px; -unity-font-style: bold; }
.hero-respawn {
    display: none;
    position: absolute;
    top: 56px;
    left: 20%;
    right: 20%;
    padding: 12px 16px;
    background-color: rgba(17, 27, 36, 0.85);
    color: rgb(255, 225, 132);
    font-size: 22px;
    -unity-font: url("project://database/Assets/Content/Shared/Fonts/Inter-Regular.otf");
    -unity-text-align: middle-center;
    white-space: normal;
}
.buttons { flex-direction: row; flex-wrap: wrap; margin-top: 6px; margin-bottom: 5px; }
.buttons Button {
    margin-right: 7px;
    padding: 5px 12px;
    background-color: rgb(44, 69, 80);
    color: white;
    border-color: rgb(98, 131, 142);
    border-width: 1px;
}
.buttons Button:hover { background-color: rgb(57, 104, 111); }
.construction-hint { color: rgb(255, 225, 132); white-space: normal; margin-top: 5px; }
.construction-menu {
    position: absolute;
    width: 300px;
    max-width: 96%;
    background-color: rgb(25, 39, 43);
    color: rgb(245, 241, 220);
    padding: 10px;
    border-width: 2px;
    border-color: rgb(174, 151, 92);
    font-size: 14px;
}
.construction-menu Label { white-space: normal; margin-bottom: 6px; flex-shrink: 0; min-height: 22px; }
.construction-menu Button {
    white-space: normal;
    background-color: rgb(48, 71, 74);
    color: rgb(255, 247, 214);
    margin-bottom: 5px;
    padding: 8px;
    min-height: 35px;
    flex-shrink: 0;
}
.construction-menu Button:hover { background-color: rgb(70, 103, 99); }
.construction-menu Button:disabled {
    background-color: rgb(43, 47, 48);
    color: rgb(141, 146, 145);
}
